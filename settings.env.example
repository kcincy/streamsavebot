# Configuracoes operacionais. Credenciais e WATERMARK_ENABLED ficam no .env.
# Altere e reinicie com python main.py. Variaveis do processo tem prioridade.

# Limite individual de perfis cadastrados, incluindo pausados.
MAX_MONITORS_PER_USER=3
# ID numerico do Telegram isento do limite de perfis cadastrados.
SUPERUSER_ID=0

# Servidor Telegram local ou API publica: local / public.
TELEGRAM_API_MODE=local
TELEGRAM_API_URL='http://127.0.0.1:8081'

# Sessao do site, opcional; caminho relativo a raiz ou absoluto.
SUPERLIVE_STATE=''
STRIPCHAT_STATE=

# Tamanho das partes em MB decimais; nao altera resolucao ou qualidade.
# 300 MB e 16 GiB de spool permitem 52 reservas, incluindo partes na fila.
PART_MAX_MB=300
MAX_ACTIVE_CAPTURES=100
# Temporarios em MiB; inclui captura, processamento e cache de upload.
SPOOL_MAX_MB=16384
# Prazo para alertar sobre atraso; arquivos pendentes nao sao apagados.
TEMP_RETENTION_SECONDS=3600

# 1: compartilha Chromium com contextos isolados, poupa a previa WebRTC e bloqueia imagens/fontes.
# 0: usa o comportamento visual anterior, sem alterar qualidade ou limites das gravacoes.
LOW_RESOURCE_MODE=1

# Marca central nos primeiros 30 segundos de cada arquivo; WATERMARK_ENABLED no .env controla a ativacao.
WATERMARK_TEXT=''
